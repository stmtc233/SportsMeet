    "mygo-runtime": "^0.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mygo-cli": "^0.9.0",
    "typescript": "^7",
    "vite": "^8"
  }
}
